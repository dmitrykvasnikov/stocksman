{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stocksman",
  "version": "0.1.0",
  "identifier": "com.stocksman.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stocksman",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
